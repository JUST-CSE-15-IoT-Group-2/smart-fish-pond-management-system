# Port the backend server listens on.
PORT=5000

# Node environment. Use "production" when deployed publicly, otherwise use development.
NODE_ENV=development

# MongoDB connection string the backend uses to store sensor readings, settings, and user data.
MONGODB_URI=mongodb://localhost:27017/fpms

# Secret key used to sign login sessions. Use a long, random value and keep it private.
JWT_SECRET=skfjaiufg87w4tyfhwuiohw3847gfw3783wfguergy387he

# How long a login session stays valid before requiring login again.
# 70d means 70 days.
JWT_EXPIRES_IN=70d

# The id and password someone will use to log in to the dashboard.
AUTH_USER_ID=admin
AUTH_PASSWORD=admin123

# Display name shown for the account above.
AUTH_USER_NAME=Administrator

# Address of the frontend dashboard.
FRONTEND_URL=http://localhost:3000

# These two keys below are used to send push notifications to the browser. To generate your own, run `npx web-push generate-vapid-keys` in a terminal in the backend folder and use the generated keys in your .env file. Copying the values from this file is also fine.
VAPID_PUBLIC_KEY=BMlAaSDLm-lQ327gR_7WpstteK6qKGLNhT_d4qr7tE21Eyoc6KtyAqOptPMTyRvgXrKlJJ6j_yklHTMng0_imrM
VAPID_PRIVATE_KEY=gQ_OxoWOorVa_F_nJngyQUpKfQYgbyutAZUSYv6oyo4

# This email is dummy, you can set anything.
VAPID_SUBJECT=mailto:admin@smartpond.local
