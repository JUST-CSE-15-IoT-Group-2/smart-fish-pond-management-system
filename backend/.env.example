# ============================================================
# Fish Pond Management System — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in real values

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Local:  mongodb://localhost:27017/fpms
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/fpms
MONGODB_URI=mongodb://localhost:27017/fpms

# --- JWT ---
# Generate a strong random string: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret_string_here
JWT_EXPIRES_IN=7d

# --- Google OAuth 2.0 ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI to add: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Frontend ---
# The URL your Next.js app runs on (for CORS + post-auth redirect)
FRONTEND_URL=http://localhost:3000
